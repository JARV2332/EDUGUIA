# Groq (chat / informe IA) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# EduKids activo por defecto. EDUGUIA/campus/admin pausados hasta que actives:
# EDUGUIA_ENABLED=true
# (No hace falta MAINTENANCE_MODE en Vercel)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Solo servidor (crear usuarios del campus desde el admin). Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Sitio público (URLs de retorno Recurrente / SEO)
NEXT_PUBLIC_SITE_URL=https://edukidsgt.com

# Recurrente — Botón Clave en /servicios (Configuración → Botón Clave)
NEXT_PUBLIC_RECURRENTE_ACCOUNT=your_recurrente_account_id
# Firma del carrito (Botón Clave → secreto sig_live_… en Configuración → Botón Clave). Solo servidor.
RECURRENTE_SIGNATURE_KEY=your_recurrente_sig_live_key
